GIT_NAME="Anthony Jackman"
GIT_EMAIL=energeticpixels@gmail.com
GPG_EXPIRATION=1y
NEOVIM_VERSION=0.12.0
WEB_SERVER=apache
PHP_ENABLE=false
PHP_VERSION=7.4
PHP_EXTENSIONS_BASELINE=common
PHP_EXTENSIONS_EXTRA=
PHP_EXTENSIONS_STRICT=true
# PHP database driver mode: auto (follows DATABASE_TYPE), mysql, postgres, none
PHP_DB_DRIVER_MODE=auto
JAVA_ENABLE=false
JAVA_VERSION=8
JAVA_SERVER_MODE=tomcat
JAVA_DISTRO=temurin
JAVA_APP_JAR_PATH=
JAVA_APP_PORT=8081
JAVA_APP_ARGS=
NODE_ENABLE=false
NODE_DEFAULT_VERSION=22
NODE_VERSIONS=22
NODE_NVM_VERSION=v0.40.3
NODE_GLOBAL_PACKAGES=

# Redis Cache Configuration
REDIS_ENABLE=false
REDIS_VERSION=7.0

# Database Configuration
# Choose which database to provision: mysql, postgres, mongodb, or none (default: none)
# WARNING: Passwords stored in plaintext in .env are for development/WSL only, NOT for production
DATABASE_TYPE=none
MARIADB_VERSION=10.5
POSTGRESQL_VERSION=17
MONGODB_VERSION=8.0

# Database Development Setup (used for mysql, postgres, and mongodb)
# Set DB_DEV_SETUP=true to automatically create a development database and user
DB_DEV_SETUP=false
DB_DEV_DB_NAME=dev_db
DB_DEV_USER=dev_user
DB_DEV_PASSWORD=dev_password
DB_DEV_USER_HOST=localhost